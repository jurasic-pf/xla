  l2_yf = f32[11,1152]{1,0} convert(l2_y)
  l2_xs = f32[11,1152]{1,0} add(l2_xf, l2_yf)
  l2_x = bf16[11,1152]{1,0} convert(l2_xs)
  l3_w = bf16[1152,1152]{1,0} parameter(4)
  l3_xf = f32[11,1152]{1,0} convert(l2_x)
