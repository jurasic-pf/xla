  l1_y = bf16[11,1152]{1,0} dot(l1_nb, l1_w), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  l1_yf = f32[11,1152]{1,0} convert(l1_y)
  l1_xs = f32[11,1152]{1,0} add(l1_xf, l1_yf)
  l1_x = bf16[11,1152]{1,0} convert(l1_xs)
  l2_w = bf16[1152,1152]{1,0} parameter(3)
  l2_xf = f32[11,1152]{1,0} convert(l1_x)
  l2_sq = f32[11,1152]{1,0} multiply(l2_xf, l2_xf)
  l2_ss = f32[11]{0} reduce(l2_sq, zero), dimensions={1}, to_apply=add_f32
  l2_bi = f32[11]{0} broadcast(invd), dimensions={}
