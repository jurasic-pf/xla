HloModule residual_4

add_f32 {
  a = f32[] parameter(0)
  b = f32[] parameter(1)
  ROOT s = f32[] add(a, b)
}

ENTRY main {
  x0 = bf16[11,1152]{1,0} parameter(0)
  zero = f32[] constant(0)
  invd = f32[] constant(0.0008680555555555555)
  eps = f32[] constant(1e-6)
  l0_w = bf16[1152,1152]{1,0} parameter(1)
