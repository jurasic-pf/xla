HloModule reduce_product_rows

add {
  lhs = f32[] parameter(0)
  rhs = f32[] parameter(1)
  ROOT add = f32[] add(lhs, rhs)
}

ENTRY main {
  x = f32[64,1048576] parameter(0)
  y = f32[64,1048576] parameter(1)
  m = f32[64,1048576] multiply(x, y)
  c = f32[] constant(0)
  ROOT r = f32[64] reduce(m, c), dimensions={1}, to_apply=add
}
