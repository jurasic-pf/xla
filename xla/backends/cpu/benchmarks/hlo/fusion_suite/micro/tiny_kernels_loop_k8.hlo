HloModule tiny_kernels_loop_k8

%body {
  %p = (s32[], f64[], f64[], f64[], f64[], f64[], f64[], f64[], f64[]) parameter(0)
  %i = s32[] get-tuple-element(%p), index=0
  %one = s32[] constant(1)
  %i1 = s32[] add(%i, %one)
  %c = f64[] constant(0.999)
  %x0 = f64[] get-tuple-element(%p), index=1
  %sn0 = f64[] sine(%x0)
  %m0 = f64[] multiply(%sn0, %c)
  %y0 = f64[] add(%m0, %x0)
  %x1 = f64[] get-tuple-element(%p), index=2
  %sn1 = f64[] sine(%x1)
  %m1 = f64[] multiply(%sn1, %c)
  %y1 = f64[] add(%m1, %x1)
  %x2 = f64[] get-tuple-element(%p), index=3
  %sn2 = f64[] sine(%x2)
  %m2 = f64[] multiply(%sn2, %c)
  %y2 = f64[] add(%m2, %x2)
  %x3 = f64[] get-tuple-element(%p), index=4
  %sn3 = f64[] sine(%x3)
  %m3 = f64[] multiply(%sn3, %c)
  %y3 = f64[] add(%m3, %x3)
  %x4 = f64[] get-tuple-element(%p), index=5
  %sn4 = f64[] sine(%x4)
  %m4 = f64[] multiply(%sn4, %c)
  %y4 = f64[] add(%m4, %x4)
  %x5 = f64[] get-tuple-element(%p), index=6
  %sn5 = f64[] sine(%x5)
  %m5 = f64[] multiply(%sn5, %c)
  %y5 = f64[] add(%m5, %x5)
  %x6 = f64[] get-tuple-element(%p), index=7
  %sn6 = f64[] sine(%x6)
  %m6 = f64[] multiply(%sn6, %c)
  %y6 = f64[] add(%m6, %x6)
  %x7 = f64[] get-tuple-element(%p), index=8
  %sn7 = f64[] sine(%x7)
  %m7 = f64[] multiply(%sn7, %c)
  %y7 = f64[] add(%m7, %x7)
  ROOT %t = (s32[], f64[], f64[], f64[], f64[], f64[], f64[], f64[], f64[]) tuple(%i1, %y0, %y1, %y2, %y3, %y4, %y5, %y6, %y7)
}

%cond {
  %p = (s32[], f64[], f64[], f64[], f64[], f64[], f64[], f64[], f64[]) parameter(0)
  %i = s32[] get-tuple-element(%p), index=0
  %n = s32[] constant(10000)
  ROOT %lt = pred[] compare(%i, %n), direction=LT
}

ENTRY main {
  %a0 = f64[] parameter(0)
  %a1 = f64[] parameter(1)
  %a2 = f64[] parameter(2)
  %a3 = f64[] parameter(3)
  %a4 = f64[] parameter(4)
  %a5 = f64[] parameter(5)
  %a6 = f64[] parameter(6)
  %a7 = f64[] parameter(7)
  %z = s32[] constant(0)
  %init = (s32[], f64[], f64[], f64[], f64[], f64[], f64[], f64[], f64[]) tuple(%z, %a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7)
  ROOT %w = (s32[], f64[], f64[], f64[], f64[], f64[], f64[], f64[], f64[]) while(%init), condition=%cond, body=%body
}
