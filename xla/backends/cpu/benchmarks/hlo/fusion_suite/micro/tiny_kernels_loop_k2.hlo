HloModule tiny_kernels_loop_k2

%body {
  %p = (s32[], f64[], f64[]) parameter(0)
  %i = s32[] get-tuple-element(%p), index=0
  %one = s32[] constant(1)
  %i1 = s32[] add(%i, %one)
  %c = f64[] constant(0.999)
  %x0 = f64[] get-tuple-element(%p), index=1
  %sn0 = f64[] sine(%x0)
  %m0 = f64[] multiply(%sn0, %c)
  %y0 = f64[] add(%m0, %x0)
  %x1 = f64[] get-tuple-element(%p), index=2
  %sn1 = f64[] sine(%x1)
  %m1 = f64[] multiply(%sn1, %c)
  %y1 = f64[] add(%m1, %x1)
  ROOT %t = (s32[], f64[], f64[]) tuple(%i1, %y0, %y1)
}

%cond {
  %p = (s32[], f64[], f64[]) parameter(0)
  %i = s32[] get-tuple-element(%p), index=0
  %n = s32[] constant(10000)
  ROOT %lt = pred[] compare(%i, %n), direction=LT
}

ENTRY main {
  %a0 = f64[] parameter(0)
  %a1 = f64[] parameter(1)
  %z = s32[] constant(0)
  %init = (s32[], f64[], f64[]) tuple(%z, %a0, %a1)
  ROOT %w = (s32[], f64[], f64[]) while(%init), condition=%cond, body=%body
}
